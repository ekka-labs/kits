#!/usr/bin/env python3
"""Name the AI's pick for one decide run, from what EKKA recorded.

    show-verdict <file holding `ekka run show <run>` output> [--word]

The pick is the one EKKA ACTED ON: the bounded fact the Enclave let cross, printed by
`ekka run show` as `grades  decide: pick=<AAPL|SPY>`. The Enclave lets it cross only if the AI's
JSON reply names exactly one of the two declared words, so nothing else can become an order.

No pick fact has two causes, never confused: the plan took its default branch
(`plan_transitioned_to_fail`), which means the AI answered with something that is not a declared
word: invalid_model_output. Anything else means the AI never answered (a missing grant, no
credit, a platform error): no_verdict, and the AI is not blamed for it."""
import json, re, sys

args = [a for a in sys.argv[1:] if not a.startswith("--")]
word_only = "--word" in sys.argv
if not args:
    print(__doc__); sys.exit(1)
try:
    text = open(args[0]).read()
except Exception:
    text = ""
m = re.search(r"grades\s+decide:\s*pick=(AAPL|SPY)\b", text)
if m:
    pick = m.group(1)
elif "plan_transitioned_to_fail" in text:
    pick = "invalid_model_output"
else:
    pick = "no_verdict"
why = ""
for block in re.findall(r"\{[^{}]*\"pick\"[^{}]*\}", text):
    try:
        j = json.loads(block)
        if j.get("pick") == pick:
            why = str(j.get("explanation", "")).strip()
            break
    except Exception:
        continue
if word_only:
    print(pick); sys.exit(0)
print(f"pick          {pick}   (the fact EKKA recorded and acted on)")
if pick == "invalid_model_output":
    print("explanation   none: the reply was not AAPL or SPY, so it cannot become an order")
elif pick == "no_verdict":
    print("explanation   none: the AI did not answer; the run stopped before or at the AI step")
else:
    print(f"explanation   {why or '(the AI gave none)'}")
