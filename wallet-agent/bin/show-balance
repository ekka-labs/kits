#!/usr/bin/env python3
"""Print the balance from a balance run on this machine.

Each run's answer is saved on this machine under ~/.ekka/artifacts/<run>/call.json
(`ekka plan run` prints the exact path on its "Its output is at" line). Pass that
path to show that run. With no argument this opens the newest balance answer."""
import glob, json, os, sys

# The row lives in the person's own catalog, so the resource is apis/<their-org>/eth-balance…
ROWS = {
    "/eth-balance-sepolia": "Sepolia test network",
}

def network(resource):
    for suffix, name in ROWS.items():
        if isinstance(resource, str) and resource.endswith(suffix):
            return name
    return None

def load(p):
    try:
        d = json.load(open(p))
    except Exception:
        return None
    if network(d.get("resource")) and isinstance(d.get("body"), dict) and "hash" in d["body"]:
        return d
    return None

if len(sys.argv) > 1 and sys.argv[1]:
    d = load(sys.argv[1])
    if d is None:
        print(f"No balance answer at {sys.argv[1]}"); sys.exit(1)
else:
    found = []
    for p in glob.glob(os.path.expanduser("~/.ekka/artifacts/*/call.json")) + glob.glob(os.path.expanduser("~/.ekka/*/artifacts/*/call.json")):
        d = load(p)
        if d is not None:
            found.append((os.path.getmtime(p), d))
    if not found:
        print("No balance has been read yet. Run step 2 first."); sys.exit(1)
    _, d = max(found)

raw = d["body"].get("coin_balance")
print(f"wallet   {d['body'].get('hash', '')}")
if raw is None:
    # Blockscout answers null for an address the network has never seen: no transaction in or out yet.
    print(f"balance  0 ETH   ({network(d['resource'])}; this address has no activity yet. Faucet ETH not arrived?)")
else:
    print(f"balance  {int(raw) / 1e18:.6f} ETH   ({network(d['resource'])})")
