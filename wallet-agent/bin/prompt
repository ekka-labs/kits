#!/usr/bin/env python3
"""Write the one message the AI is sent, from named inputs and nothing else.

    prompt <inputs.json> <out.txt>

The AI decides whether to pay one invoice. The rule is the kit's example; edit RULE below and it
is your rule. Nothing else reaches the AI: no key, no other payment, no other wallet."""
import json, sys

RULE = ("Pay only if BOTH are true:\n"
        "1. The payee is on the approved list.\n"
        "2. After paying the amount and a network fee of up to {fee_cap} test ETH, at least {floor} test ETH is left.\n"
        "Otherwise hold.")

if len(sys.argv) != 3:
    print("usage: prompt <inputs.json> <out.txt>"); sys.exit(1)
i = json.load(open(sys.argv[1]))
approved = "\n".join(f"  - {a}" for a in i["approved"]) or "  (none)"
msg = f"""You decide whether to pay one invoice, using the rule below. Sepolia test network only: test ETH has no value.

RULE:
{RULE.format(fee_cap=i['fee_cap_eth'], floor=i['floor_eth'])}

INPUTS:
- The invoice: pay {i['amount_eth']} test ETH to {i['payee']} for {i['for']}.
- The approved list:
{approved}
- The wallet's balance now: {i['balance_eth']} test ETH (read from the network just now).

Use only these inputs.

Answer with JSON and nothing else, in exactly this shape:
{{"decision": "pay" | "hold", "explanation": "<two sentences at most, naming the numbers you used>"}}
"""
open(sys.argv[2], "w").write(msg)
print(msg)
